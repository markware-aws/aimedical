---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES, categoryLabel } from "../consts";
import { getPublishedArticles } from "../lib/articles";
import { buildSearchIndex } from "../lib/search-index";
import { PAGE_SIZE } from "../lib/pagination";

const articles = await getPublishedArticles();
const searchIndex = buildSearchIndex(articles);
const categoryOptions = CATEGORIES.filter((category) =>
  articles.some((article) => article.data.category === category.slug)
);
---
<BaseLayout
  title="Αναζήτηση"
  description="Αναζητήστε άρθρα για την τεχνητή νοημοσύνη στην ιατρική ανά τίτλο, περιγραφή, tag, πάθηση ή κατηγορία."
  canonicalPath="/search/"
>
  <section class="mb-8 overflow-hidden rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark">
    <div class="relative p-6 md:p-8">
      <div class="absolute inset-y-0 right-0 hidden w-1/3 bg-[radial-gradient(circle_at_70%_35%,rgba(15,76,117,0.16),transparent_36%),radial-gradient(circle_at_40%_75%,rgba(42,127,126,0.14),transparent_34%)] dark:bg-[radial-gradient(circle_at_70%_35%,rgba(91,163,208,0.18),transparent_36%),radial-gradient(circle_at_40%_75%,rgba(93,181,179,0.16),transparent_34%)] md:block" aria-hidden="true" />
      <div class="relative max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent dark:text-accent-dark">
          Αναζήτηση
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">Βρείτε άρθρα γρήγορα</h1>
        <p class="mt-3 text-sm leading-relaxed text-muted dark:text-muted-dark">
          Αναζήτηση σε τίτλους, περιγραφές, πρωτότυπους τίτλους, tags, παθήσεις και κατηγορίες. Η αναζήτηση δουλεύει τοπικά στον browser και αγνοεί τους τόνους.
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8 rounded-xl border border-border dark:border-border-dark bg-bg dark:bg-bg-dark p-4 shadow-card">
    <label for="search-page-input" class="sr-only">Αναζήτηση άρθρων</label>
    <div class="flex items-center gap-3 rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-4 py-3">
      <svg class="h-5 w-5 shrink-0 text-muted dark:text-muted-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
      <input
        id="search-page-input"
        type="search"
        class="w-full bg-transparent text-base text-ink dark:text-ink-dark placeholder:text-muted dark:placeholder:text-muted-dark focus:outline-none"
        autocomplete="off"
      />
    </div>

    <div class="mt-4 flex flex-wrap gap-2" aria-label="Φίλτρα κατηγοριών">
      <button
        type="button"
        class="search-category rounded-full border border-accent/40 bg-accent/10 px-3 py-1 text-xs font-medium text-accent dark:border-accent-dark/40 dark:bg-accent-dark/10 dark:text-accent-dark"
        data-category=""
        aria-pressed="true"
      >
        Όλα
      </button>
      {categoryOptions.map((category) => (
        <button
          type="button"
          class="search-category rounded-full border border-border dark:border-border-dark px-3 py-1 text-xs font-medium text-muted dark:text-muted-dark transition-colors hover:border-accent/40 hover:text-accent dark:hover:border-accent-dark/40 dark:hover:text-accent-dark"
          data-category={category.slug}
          aria-pressed="false"
        >
          {category.labelGr}
        </button>
      ))}
    </div>

    <p id="search-status" class="mt-4 text-sm text-muted dark:text-muted-dark">
      Πληκτρολογήστε έναν όρο για να εμφανιστούν αποτελέσματα.
    </p>
  </section>

  <section id="search-list" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" aria-live="polite" hidden></section>

  <p id="search-empty-state" class="hidden rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 text-center text-muted dark:text-muted-dark">
    Δεν βρέθηκαν άρθρα για αυτή την αναζήτηση.
  </p>

  <nav
    id="search-pagination"
    class="mt-10 hidden flex-wrap items-center justify-between gap-4 border-t border-border dark:border-border-dark pt-6"
    aria-label="Σελιδοποίηση αποτελεσμάτων"
  >
    <p id="search-page-info" class="text-sm text-muted dark:text-muted-dark"></p>
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="search-prev"
        class="rounded-md border border-border dark:border-border-dark px-3 py-1.5 text-sm text-ink dark:text-ink-dark transition-colors hover:bg-surface dark:hover:bg-surface-dark disabled:cursor-not-allowed disabled:opacity-60"
        disabled
      >
        ← Προηγούμενη
      </button>
      <button
        type="button"
        id="search-next"
        class="rounded-md border border-border dark:border-border-dark px-3 py-1.5 text-sm text-ink dark:text-ink-dark transition-colors hover:bg-surface dark:hover:bg-surface-dark disabled:cursor-not-allowed disabled:opacity-60"
        disabled
      >
        Επόμενη →
      </button>
    </div>
  </nav>
</BaseLayout>

<script is:inline type="application/json" id="search-page-data" set:html={JSON.stringify({ articles: searchIndex, pageSize: PAGE_SIZE })} />

<script is:inline>
  (function () {
    var dataEl = document.getElementById("search-page-data");
    var input = document.getElementById("search-page-input");
    var status = document.getElementById("search-status");
    var list = document.getElementById("search-list");
    var emptyState = document.getElementById("search-empty-state");
    var pagination = document.getElementById("search-pagination");
    var pageInfo = document.getElementById("search-page-info");
    var prevBtn = document.getElementById("search-prev");
    var nextBtn = document.getElementById("search-next");
    var buttons = Array.prototype.slice.call(document.querySelectorAll(".search-category"));
    if (!dataEl || !input || !status || !list || !emptyState || !pagination || !pageInfo || !prevBtn || !nextBtn) return;

    var payload = JSON.parse(dataEl.textContent || "{}");
    var pageSize = payload.pageSize || 24;
    var articles = (payload.articles || []).map(function (article) {
      article.normalizedSearchText = normalize(article.searchText);
      return article;
    });

    var activeCategory = "";
    var currentPage = 1;
    var filtered = [];

    function normalize(value) {
      return String(value || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/ς/g, "σ");
    }

    function clear(node) {
      while (node.firstChild) node.removeChild(node.firstChild);
    }

    function renderCard(article) {
      var link = document.createElement("a");
      link.href = article.url;
      link.className = "group block no-underline";

      var card = document.createElement("article");
      card.className = "card card-hover h-full overflow-hidden";

      var inner = document.createElement("div");
      inner.className = "p-5";

      var badge = document.createElement("div");
      badge.className = "mb-2 inline-flex rounded-full border border-border dark:border-border-dark px-2.5 py-0.5 text-xs font-medium text-ink dark:text-ink-dark";
      badge.textContent = article.categoryGr;

      var title = document.createElement("h3");
      title.className = "mb-2 text-lg font-semibold leading-snug text-ink dark:text-ink-dark group-hover:text-accent dark:group-hover:text-accent-dark transition-colors";
      title.textContent = article.title;

      inner.appendChild(badge);
      inner.appendChild(title);

      if (article.description) {
        var description = document.createElement("p");
        description.className = "mb-4 line-clamp-2 text-sm leading-relaxed text-muted dark:text-muted-dark";
        description.textContent = article.description;
        inner.appendChild(description);
      }

      var date = document.createElement("div");
      date.className = "text-xs text-muted dark:text-muted-dark";
      date.textContent = article.date;
      inner.appendChild(date);

      card.appendChild(inner);
      link.appendChild(card);
      return link;
    }

    function setActiveButton(nextCategory) {
      buttons.forEach(function (button) {
        var isActive = button.getAttribute("data-category") === nextCategory;
        button.setAttribute("aria-pressed", String(isActive));
        button.classList.toggle("border-accent/40", isActive);
        button.classList.toggle("bg-accent/10", isActive);
        button.classList.toggle("text-accent", isActive);
        button.classList.toggle("dark:border-accent-dark/40", isActive);
        button.classList.toggle("dark:bg-accent-dark/10", isActive);
        button.classList.toggle("dark:text-accent-dark", isActive);
        button.classList.toggle("border-border", !isActive);
        button.classList.toggle("dark:border-border-dark", !isActive);
        button.classList.toggle("text-muted", !isActive);
        button.classList.toggle("dark:text-muted-dark", !isActive);
      });
    }

    function computeFiltered() {
      var query = normalize(input.value);
      if (!query) return [];

      return articles.filter(function (article) {
        var matchesQuery = article.normalizedSearchText.indexOf(query) !== -1;
        var matchesCategory = !activeCategory || article.category === activeCategory;
        return matchesQuery && matchesCategory;
      });
    }

    function renderPage() {
      clear(list);
      var totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
      if (currentPage > totalPages) currentPage = totalPages;
      var start = (currentPage - 1) * pageSize;
      var pageItems = filtered.slice(start, start + pageSize);

      pageItems.forEach(function (article) {
        list.appendChild(renderCard(article));
      });

      var hasQuery = normalize(input.value).length > 0;
      list.hidden = !hasQuery || filtered.length === 0;
      emptyState.classList.toggle("hidden", !hasQuery || filtered.length > 0);
      pagination.classList.toggle("hidden", !hasQuery || filtered.length <= pageSize);

      if (hasQuery && filtered.length > 0) {
        status.textContent =
          filtered.length === 1
            ? "1 άρθρο"
            : filtered.length + " άρθρα";
        pageInfo.textContent = "Σελίδα " + currentPage + " από " + totalPages;
      } else if (hasQuery) {
        status.textContent = "Δεν βρέθηκαν άρθρα.";
      } else {
        status.textContent = "Πληκτρολογήστε έναν όρο για να εμφανιστούν αποτελέσματα.";
      }

      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
    }

    function runSearch() {
      currentPage = 1;
      filtered = computeFiltered();
      renderPage();
    }

    input.addEventListener("input", runSearch);
    buttons.forEach(function (button) {
      button.addEventListener("click", function () {
        activeCategory = button.getAttribute("data-category") || "";
        setActiveButton(activeCategory);
        runSearch();
      });
    });
    prevBtn.addEventListener("click", function () {
      if (currentPage > 1) {
        currentPage -= 1;
        renderPage();
        list.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
    nextBtn.addEventListener("click", function () {
      var totalPages = Math.ceil(filtered.length / pageSize);
      if (currentPage < totalPages) {
        currentPage += 1;
        renderPage();
        list.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  })();
</script>
