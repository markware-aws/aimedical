---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES } from "../consts";
import { getCategoryCounts } from "../lib/articles";

const counts = await getCategoryCounts();
const categories = CATEGORIES.map((category) => ({
  ...category,
  count: counts.get(category.slug) ?? 0,
}));
const activeCategories = categories.filter((category) => category.count > 0);
const emptyCategories = categories.filter((category) => category.count === 0);
---
<BaseLayout
  title="Κατηγορίες"
  description="Εξερευνήστε άρθρα για την τεχνητή νοημοσύνη στην ιατρική ανά κλινικό πεδίο και ερευνητική θεματική."
  canonicalPath="/categories/"
>
  <section class="mb-8 border-b border-border dark:border-border-dark pb-6">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent dark:text-accent-dark">
      Θεματικός χάρτης
    </p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">Κατηγορίες</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted dark:text-muted-dark">
      Οι μεγάλες κλινικές ενότητες μένουν συγκεντρωμένες εδώ, ενώ τα tags και οι παθήσεις δίνουν πιο λεπτομερή πλοήγηση μέσα σε κάθε άρθρο.
    </p>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-semibold tracking-tight">Με διαθέσιμα άρθρα</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {activeCategories.map((category) => (
        <a href={`/category/${category.slug}/`} class="card card-hover group flex min-h-32 flex-col justify-between p-5 no-underline">
          <div>
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-accent dark:text-accent-dark">
              {category.count} {category.count === 1 ? "άρθρο" : "άρθρα"}
            </p>
            <h3 class="text-xl font-semibold tracking-tight text-ink dark:text-ink-dark group-hover:text-accent dark:group-hover:text-accent-dark">
              {category.labelGr}
            </h3>
          </div>
          <span class="mt-5 text-sm text-muted dark:text-muted-dark group-hover:text-accent dark:group-hover:text-accent-dark">
            Προβολή κατηγορίας →
          </span>
        </a>
      ))}
    </div>
  </section>

  {emptyCategories.length > 0 && (
    <section>
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-muted dark:text-muted-dark">
        Αναμένονται άρθρα
      </h2>
      <div class="flex flex-wrap gap-2">
        {emptyCategories.map((category) => (
          <a
            href={`/category/${category.slug}/`}
            class="rounded-full border border-border dark:border-border-dark px-3 py-1 text-sm text-muted dark:text-muted-dark no-underline hover:border-accent/40 hover:text-accent dark:hover:border-accent-dark/40 dark:hover:text-accent-dark"
          >
            {category.labelGr}
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
