---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import Pagination from "../../../components/Pagination.astro";
import { getByTag, getTags, type Article } from "../../../lib/articles";
import { paginate, pageHref } from "../../../lib/pagination";

export async function getStaticPaths() {
  const tags = await getTags();
  const paths = [];

  for (const { tag, slug } of tags) {
    const articles = await getByTag(slug);
    const pages = paginate(articles);
    const basePath = `/tag/${slug}/`;

    for (let index = 1; index < pages.length; index++) {
      const currentPage = index + 1;
      paths.push({
        params: { tag: slug, page: String(currentPage) },
        props: {
          articles: pages[index],
          tag,
          slug,
          currentPage,
          totalPages: pages.length,
          totalArticles: articles.length,
          basePath,
        },
      });
    }
  }

  return paths;
}

interface Props {
  articles: Article[];
  tag: string;
  slug: string;
  currentPage: number;
  totalPages: number;
  totalArticles: number;
  basePath: string;
}

const { articles, tag, slug, currentPage, totalPages, totalArticles, basePath } = Astro.props;
---
<BaseLayout
  title={`#${tag} · Tags · Σελίδα ${currentPage}`}
  description={`Articles tagged with ${tag}.`}
  canonicalPath={pageHref(basePath, currentPage)}
>
  <section class="mb-8 border-b border-border dark:border-border-dark pb-6">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent dark:text-accent-dark">
      Tag
    </p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">#{tag}</h1>
    <p class="mt-2 text-sm text-muted dark:text-muted-dark">{totalArticles} άρθρα</p>
  </section>

  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {articles.map((article) => <ArticleCard article={article} />)}
  </div>
  <Pagination basePath={basePath} currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
