---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import Pagination from "../../../components/Pagination.astro";
import { getByTag, getTags, type Article } from "../../../lib/articles";
import { paginate, pageHref } from "../../../lib/pagination";

export async function getStaticPaths() {
  const tags = await getTags();
  return Promise.all(
    tags.map(async ({ tag, slug }) => {
      const articles = await getByTag(slug);
      const pages = paginate(articles);
      return {
        params: { tag: slug },
        props: {
          articles: pages[0] ?? [],
          tag,
          slug,
          currentPage: 1,
          totalPages: pages.length,
          totalArticles: articles.length,
          basePath: `/tag/${slug}/`,
        },
      };
    }),
  );
}

interface Props {
  articles: Article[];
  tag: string;
  slug: string;
  currentPage: number;
  totalPages: number;
  totalArticles: number;
  basePath: string;
}

const { articles, tag, slug, currentPage, totalPages, totalArticles, basePath } = Astro.props;
---
<BaseLayout
  title={`#${tag} · Tags`}
  description={`Articles tagged with ${tag}.`}
  canonicalPath={pageHref(basePath, currentPage)}
>
  <section class="mb-8 border-b border-border dark:border-border-dark pb-6">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent dark:text-accent-dark">
      Tag
    </p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">#{tag}</h1>
    <p class="mt-2 text-sm text-muted dark:text-muted-dark">{totalArticles} άρθρα</p>
  </section>

  {totalArticles === 0 ? (
    <p class="rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 text-center text-muted dark:text-muted-dark">
      Δεν υπάρχουν δημοσιευμένα άρθρα με αυτό το tag.
    </p>
  ) : (
    <>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
      <Pagination basePath={basePath} currentPage={currentPage} totalPages={totalPages} />
    </>
  )}
</BaseLayout>
