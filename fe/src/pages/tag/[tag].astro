---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getByTag, getTags, type Article } from "../../lib/articles";

export async function getStaticPaths() {
  const tags = await getTags();
  return Promise.all(
    tags.map(async ({ tag, slug }) => ({
      params: { tag: slug },
      props: { articles: await getByTag(slug), tag, slug },
    })),
  );
}

interface Props {
  articles: Article[];
  tag: string;
  slug: string;
}

const { articles, tag, slug } = Astro.props;
---
<BaseLayout
  title={`#${tag} · Tags`}
  description={`Articles tagged with ${tag}.`}
  canonicalPath={`/tag/${slug}`}
>
  <section class="mb-8 border-b border-border dark:border-border-dark pb-6">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent dark:text-accent-dark">
      Tag
    </p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">#{tag}</h1>
    <p class="mt-2 text-sm text-muted dark:text-muted-dark">{articles.length} articles</p>
  </section>

  {articles.length === 0 ? (
    <p class="rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 text-center text-muted dark:text-muted-dark">
      No published articles use this tag yet.
    </p>
  ) : (
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  )}
</BaseLayout>
